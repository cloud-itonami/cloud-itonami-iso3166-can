#:culture{:id "can.dish.poutine", :name "Poutine", :country "CAN", :kind :dish, :summary "Dish of french fries and cheese curds topped with hot gravy that emerged in the Centre-du-Québec region of Quebec in 1959; internationally often identified as Canadian, an identification some scholars regard as appropriation of Québécois culture.", :url "https://en.wikipedia.org/wiki/Poutine", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "can.dish.butter-tart", :name "Butter tart", :country "CAN", :kind :dish, :summary "Small pastry tart of butter, brown sugar and eggs, highly regarded in Canadian cuisine and commemorated on a 2019 Canada Post stamp in the Sweet Canada series.", :url "https://en.wikipedia.org/wiki/Butter_tart", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "can.dish.nanaimo-bar", :name "Nanaimo bar", :country "CAN", :kind :dish, :summary "No-bake layered bar dessert named after the Canadian city of Nanaimo, British Columbia, promoted as a classic Canadian dessert at Expo 86.", :url "https://en.wikipedia.org/wiki/Nanaimo_bar", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "can.dish.tourtiere", :name "Tourtière", :country "CAN", :kind :dish, :summary "French Canadian meat pie originating from the province of Quebec, a traditional part of the Christmas réveillon and New Year's Eve meal, served throughout Canada.", :url "https://en.wikipedia.org/wiki/Tourtière", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "can.product.maple-syrup", :name "Maple syrup", :country "CAN", :kind :product, :summary "Syrup made from maple-tree sap; Canada produces more than 75 percent of the world's maple syrup, with Quebec alone accounting for 72 percent of global output.", :url "https://en.wikipedia.org/wiki/Maple_syrup", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "can.beverage.ice-wine", :name "Ice wine", :country "CAN", :kind :beverage, :summary "Dessert wine made from grapes frozen on the vine; Canada is the world's largest producer, making more icewine than all other countries combined, over 90 percent of it in Ontario.", :url "https://en.wikipedia.org/wiki/Ice_wine", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "can.beverage.caesar", :name "Caesar", :country "CAN", :kind :beverage, :summary "Cocktail of vodka, Clamato juice, hot sauce and Worcestershire sauce, invented in 1969 by Walter Chell in Calgary, Alberta; it remains primarily a Canadian phenomenon.", :url "https://en.wikipedia.org/wiki/Caesar_(cocktail)", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "can.craft.cowichan-knitting", :name "Cowichan knitting", :country "CAN", :kind :craft, :summary "Form of knitting characteristic of the Cowichan people of southeastern Vancouver Island, British Columbia, producing distinctive heavy patterned sweaters.", :url "https://en.wikipedia.org/wiki/Cowichan_knitting", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
